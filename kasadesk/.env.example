# ---- Step 1 (database + redis) ----
# App connections: RLS-enforced role for API/worker, BYPASSRLS role for worker sweeps only.
DATABASE_URL=postgres://kasadesk_app:dev_app_pw@localhost:5432/kasadesk
DATABASE_SYSTEM_URL=postgres://kasadesk_system:dev_sys_pw@localhost:5432/kasadesk
# Migrations only (CI/deploy), never loaded by the running app.
DATABASE_MIGRATOR_URL=postgres://kasadesk_migrator:dev_mig_pw@localhost:5432/kasadesk
REDIS_URL=redis://localhost:6379

# Later steps add: JWT secrets, ENCRYPTION_KEYS, Meta app credentials, SMS/email/payment keys.
