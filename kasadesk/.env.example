# Copy to .env (repo root of kasadesk/). Never commit real values.
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info
# true when running behind a load balancer / reverse proxy (so rate limits see the real client IP)
TRUST_PROXY=false

# ---- Database (roles from db/roles.sql) ----
# API + tenant-scoped jobs: RLS ENFORCED. The API refuses to start with any other role.
DATABASE_URL=postgres://kasadesk_app:dev_app_pw@localhost:5432/kasadesk
# Worker cross-tenant sweeps only (BYPASSRLS).
DATABASE_SYSTEM_URL=postgres://kasadesk_system:dev_sys_pw@localhost:5432/kasadesk
# Migrations only (CI/deploy). Not read by the API or worker.
DATABASE_MIGRATOR_URL=postgres://kasadesk_migrator:dev_mig_pw@localhost:5432/kasadesk
DATABASE_POOL_MAX=10
REDIS_URL=redis://localhost:6379

# ---- Auth ----
# openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-of-48-plus-chars
JWT_ISSUER=kasadesk
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
REFRESH_REUSE_GRACE_SECONDS=60
# Secure cookies need HTTPS. Use false only for local http development.
COOKIE_SECURE=false

# ---- Encryption of channel tokens / merchant keys at rest ----
# "id:base64(32 bytes)" comma-separated; generate with: openssl rand -base64 32
ENCRYPTION_KEYS=k1:REPLACE_WITH_openssl_rand_base64_32
ENCRYPTION_ACTIVE_KEY_ID=k1

# ---- Web ----
APP_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# ---- Rate limits ----
RATE_LIMIT_PER_MINUTE=300
AUTH_RATE_LIMIT_PER_MINUTE=10
LOGIN_MAX_FAILURES_PER_EMAIL=10
LOGIN_FAILURE_WINDOW_SECONDS=900

# Only for the built migrator (dist/): where the .sql files live.
# MIGRATIONS_DIR=/app/db/migrations
