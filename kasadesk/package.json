{
  "name": "kasadesk",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "test": "pnpm -r --workspace-concurrency=1 test",
    "typecheck": "pnpm -r typecheck",
    "db:migrate": "pnpm --filter @kasadesk/server db:migrate",
    "dev:api": "pnpm --filter @kasadesk/server dev:api",
    "dev:worker": "pnpm --filter @kasadesk/server dev:worker"
  }
}
